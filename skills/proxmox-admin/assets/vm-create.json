    "ciuser": "deploy",
    "sshkeys": "ssh-ed25519 AAAA... user@host",
    "ipconfig0": "ip=10.0.0.110/24,gw=10.0.0.1",
    "nameserver": "1.1.1.1 9.9.9.9",
