{
  "_comment": "proxmox-admin / asset: VM create parameters. Pass to `pvesh create /nodes/<node>/qemu` (--input-format json) or as -d key=value pairs to curl/cv4pve-cli api. Edit placeholders before use.",

  "vmid": 110,
  "name": "web-1",
  "description": "Created by proxmox-admin skill",
