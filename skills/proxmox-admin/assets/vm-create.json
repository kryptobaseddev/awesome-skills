  "cores": 2,
  "sockets": 1,
  "cpu": "cputype=host",
  "memory": 4096,
  "balloon": 1024,
  "numa": 0,

  "machine": "q35",
  "bios": "ovmf",
  "efidisk0": "local-lvm:1,efitype=4m,pre-enrolled-keys=1",

