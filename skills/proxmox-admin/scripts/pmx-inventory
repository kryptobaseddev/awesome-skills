#!/usr/bin/env bash
# pmx-inventory — capture live Proxmox state as git-diffable markdown.
#
# Subcommands:
#   pmx-inventory snapshot          query live node, WRITE inventory/<profile>/*.md
#   pmx-inventory diff              query live node, PRINT diff vs on-disk files
#   pmx-inventory show <category>   query live node, PRINT one category to stdout
#
# Categories:
#   hardware     CPU / RAM / disks (with SMART) / NICs
#   network      bridges / IPs / firewall mode
#   storage      pools / datasets / LVM / NFS mounts / backup jobs
#   containers   LXC inventory with role/IP/priv-status
#   vms          KVM VM inventory (skipped if `qm list` empty)
#
# Writes ONLY hardware.md / network.md / storage.md / containers.md / vms.md.
# Never touches overview.md (hand-curated).
#
# Output goes to:
#   $(pwd)/inventory/<profile>/
# unless the active config dir is a project folder (auto-detected), in which
# case it goes to <project>/inventory/<profile>/.
#
# Exit codes follow the skill convention (see lib/profile.sh header).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/profile.sh
. "$SCRIPT_DIR/lib/profile.sh"

usage() {
  cat <<USAGE
pmx-inventory — capture live Proxmox state as markdown

Usage:
  pmx-inventory snapshot [--profile <name>] [--out <dir>]
  pmx-inventory diff     [--profile <name>] [--out <dir>] [<category>]
  pmx-inventory show     [--profile <name>] <category>
  pmx-inventory --help

Categories: hardware | network | storage | containers | vms | all

Defaults:
  --profile   the active profile (\$PMX_ACTIVE_FILE or \$PMX_PROFILE)
  --out       <project-root>/inventory/<profile>/   if a project folder is detected
              \$PWD/inventory/<profile>/             otherwise

Examples:
  pmx-inventory snapshot                 # refresh all categories
  pmx-inventory show containers          # print to stdout, don't write
  pmx-inventory diff storage             # what's changed in storage since last snapshot

Files written:
  hardware.md, network.md, storage.md, containers.md, vms.md
  (overview.md is NEVER touched — it's hand-curated)
USAGE
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
CMD=""
PROFILE_ARG=""
OUT_ARG=""
CATEGORY=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    snapshot|diff|show)
      [ -z "$CMD" ] || { echo "multiple subcommands" >&2; exit 2; }
      CMD="$1"; shift ;;
    --profile) PROFILE_ARG="$2"; shift 2 ;;
    --out)     OUT_ARG="$2"; shift 2 ;;
    -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)
      if [ -z "$CATEGORY" ]; then CATEGORY="$1"; else
        echo "too many positional args" >&2; exit 2
      fi
      shift ;;
  esac
done
[ -n "$CMD" ] || { usage >&2; exit 2; }

# Validate category
case "${CATEGORY:-}" in
  ''|hardware|network|storage|containers|vms|all) ;;
  *) echo "unknown category: $CATEGORY (expected: hardware|network|storage|containers|vms|all)" >&2; exit 2 ;;
esac

# show requires a category
if [ "$CMD" = "show" ] && { [ -z "$CATEGORY" ] || [ "$CATEGORY" = "all" ]; }; then
  echo "'show' requires a single category (not 'all')" >&2
  exit 2
fi

# ---------------------------------------------------------------------------
# Load profile, prep paths
# ---------------------------------------------------------------------------
pmx_load_profile "$PROFILE_ARG"

if [ -n "$OUT_ARG" ]; then
  OUT_DIR="$OUT_ARG"
else
  # Project folder = parent of PMX_CONFIG_DIR if PMX_CONFIG_DIR ends in .proxmox-admin
  PROJECT_ROOT=""
  case "$PMX_CONFIG_DIR" in
    */.proxmox-admin) PROJECT_ROOT="${PMX_CONFIG_DIR%/.proxmox-admin}" ;;
  esac
  if [ -n "$PROJECT_ROOT" ]; then
    OUT_DIR="$PROJECT_ROOT/inventory/$PMX_NAME"
  else
    OUT_DIR="$PWD/inventory/$PMX_NAME"
  fi
fi

SCRIPT_NAME="$(basename "$0")"
TIMESTAMP="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"

# ---------------------------------------------------------------------------
# emit_hardware / emit_network / emit_storage / emit_containers / emit_vms
#
# Each prints markdown to stdout. No file I/O here — that's separate so
# we can use the same query functions for show, diff, and snapshot.
# ---------------------------------------------------------------------------

emit_hardware() {
  local raw
  raw="$(pmx_ssh '
set -e
echo "###CPU###"
lscpu 2>/dev/null | grep -E "^(Model name|Socket|Core|Thread)" || true
echo "###MEMORY###"
free -h 2>/dev/null | awk "NR<=2"
echo "###SWAP###"
swapon --show 2>/dev/null || true
echo "###DISKS###"
for d in /dev/nvme*n1 /dev/sd[a-z]; do
  [ -b "$d" ] || continue
  size=$(lsblk -dno SIZE "$d" 2>/dev/null)
  model=$(smartctl -i "$d" 2>/dev/null | awk -F: "/^(Device Model|Model Number|Product)/ {gsub(/^[ \t]+|[ \t]+$/,\"\",\$2); print \$2; exit}")
  serial=$(smartctl -i "$d" 2>/dev/null | awk -F: "/^Serial/ {gsub(/^[ \t]+|[ \t]+$/,\"\",\$2); print \$2; exit}")
  health=$(smartctl -H "$d" 2>/dev/null | grep -E "(PASSED|FAILED|OK)" | head -1)
  printf "%s|%s|%s|%s|%s\n" "$d" "$size" "$model" "$serial" "$health"
done
echo "###NICS###"
ip -brief link show 2>/dev/null | awk "\$1 != \"lo\""
echo "###BOOT###"
[ -d /sys/firmware/efi ] && echo "UEFI" || echo "BIOS"
echo "kernel:$(uname -r)"
')"

  cat <<HEADER
# $PMX_NAME — Hardware

> Auto-generated by \`pmx-inventory snapshot\` on $TIMESTAMP.
> Hand edits will be overwritten on next refresh.

HEADER

  # CPU
  echo "## CPU"
  echo
  printf '%s\n' "$raw" | awk '/^###CPU###/{f=1;next} /^###/{f=0} f' \
    | sed 's/  */ /g' | awk '{print "- " $0}'

  # Memory
  echo
  echo "## Memory"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###MEMORY###/{f=1;next} /^###/{f=0} f'
  echo '```'
  echo
  echo "Swap:"
  echo '```'
  printf '%s\n' "$raw" | awk '/^###SWAP###/{f=1;next} /^###/{f=0} f'
  echo '```'

  # Disks
  echo
  echo "## Storage devices"
  echo
  echo "| Device | Size | Model | Serial | Health |"
  echo "|--------|------|-------|--------|--------|"
  printf '%s\n' "$raw" | awk '/^###DISKS###/{f=1;next} /^###/{f=0} f' \
    | awk -F'|' 'NF>=4 {printf "| `%s` | %s | %s | `%s` | %s |\n", $1, $2, $3, $4, $5}'

  # NICs
  echo
  echo "## Network interfaces"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###NICS###/{f=1;next} /^###/{f=0} f'
  echo '```'

  # Boot
  echo
  echo "## Boot"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###BOOT###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  cat <<FOOTER
## How to refresh

\`\`\`bash
~/.claude/skills/proxmox-admin/scripts/pmx-inventory snapshot --profile $PMX_NAME
# OR: pmx-inventory show hardware > inventory/$PMX_NAME/hardware.md
\`\`\`
FOOTER
}

emit_network() {
  local raw
  raw="$(pmx_ssh '
set -e
echo "###ADDR###"
ip -brief addr show 2>/dev/null | grep -v "^lo"
echo "###BRIDGES###"
ip -d link show type bridge 2>/dev/null | awk "/^[0-9]+:/ {print \$2}" | tr -d ":"
brctl show 2>/dev/null | tail -n +2 || true
echo "###ROUTE###"
ip route show default 2>/dev/null
echo "###CTNETS###"
for c in $(pct list 2>/dev/null | tail -n +2 | awk "{print \$1}"); do
  net=$(grep "^net0:" /etc/pve/lxc/$c.conf 2>/dev/null)
  printf "%s|%s\n" "$c" "$net"
done
echo "###FW###"
pvesh get /cluster/firewall/options --output-format json 2>/dev/null | tr -d "\n"
')"

  cat <<HEADER
# $PMX_NAME — Network

> Auto-generated by \`pmx-inventory snapshot\` on $TIMESTAMP.

HEADER

  echo "## Host addresses"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###ADDR###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## Bridges"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###BRIDGES###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## Default route"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###ROUTE###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## Container network attachments"
  echo
  echo "| CT | net0 |"
  echo "|----|------|"
  printf '%s\n' "$raw" | awk '/^###CTNETS###/{f=1;next} /^###/{f=0} f' \
    | awk -F'|' 'NF>=2 {printf "| %s | `%s` |\n", $1, $2}'

  echo
  echo "## Datacenter firewall"
  echo
  echo '```json'
  printf '%s\n' "$raw" | awk '/^###FW###/{f=1;next} /^###/{f=0} f'
  echo
  echo '```'

  echo
  cat <<FOOTER
## How to refresh

\`\`\`bash
~/.claude/skills/proxmox-admin/scripts/pmx-inventory snapshot --profile $PMX_NAME
\`\`\`
FOOTER
}

emit_storage() {
  local raw
  raw="$(pmx_ssh '
set -e
echo "###PVESM###"
pvesm status 2>/dev/null
echo "###STORAGECFG###"
cat /etc/pve/storage.cfg 2>/dev/null
echo "###ZPOOLS###"
zpool list 2>/dev/null || echo "(no zpools)"
echo "###ZPOOLSTATUS###"
zpool status 2>/dev/null || true
echo "###ZFSDATASETS###"
zfs list -t filesystem -o name,used,avail,referenced,recordsize,compression,atime,mountpoint 2>/dev/null || true
echo "###LVS###"
lvs --units g 2>/dev/null || true
echo "###MOUNTS###"
mount 2>/dev/null | grep -E "nfs|cifs" || true
echo "###BACKUPJOBS###"
cat /etc/pve/jobs.cfg 2>/dev/null || echo "(no jobs.cfg)"
')"

  cat <<HEADER
# $PMX_NAME — Storage

> Auto-generated by \`pmx-inventory snapshot\` on $TIMESTAMP.

HEADER

  echo "## Proxmox storage status"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###PVESM###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## storage.cfg"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###STORAGECFG###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## ZFS pools"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###ZPOOLS###/{f=1;next} /^###/{f=0} f'
  echo '```'
  echo
  echo "Pool details:"
  echo '```'
  printf '%s\n' "$raw" | awk '/^###ZPOOLSTATUS###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## ZFS datasets"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###ZFSDATASETS###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## LVM volumes"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###LVS###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## NFS / CIFS mounts on host"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###MOUNTS###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  echo "## Backup jobs (/etc/pve/jobs.cfg)"
  echo
  echo '```'
  printf '%s\n' "$raw" | awk '/^###BACKUPJOBS###/{f=1;next} /^###/{f=0} f'
  echo '```'

  echo
  cat <<FOOTER
## How to refresh

\`\`\`bash
~/.claude/skills/proxmox-admin/scripts/pmx-inventory snapshot --profile $PMX_NAME
\`\`\`
FOOTER
}

emit_containers() {
  # Returns a single TSV stream from the host: ctid<TAB>hostname<TAB>cores<TAB>memory<TAB>ip<TAB>rootfs<TAB>priv<TAB>features
  # Each CT on one line — easy to parse with read into named vars.
  local list rows
  list="$(pmx_ssh 'pct list 2>/dev/null')"
  rows="$(pmx_ssh '
for c in $(pct list 2>/dev/null | tail -n +2 | awk "{print \$1}"); do
  cfg=$(pct config $c 2>/dev/null)
  hostname=$(printf "%s\n" "$cfg" | awk -F": " "/^hostname:/ {print \$2; exit}")
  cores=$(printf "%s\n" "$cfg" | awk -F": " "/^cores:/ {print \$2; exit}")
  memory=$(printf "%s\n" "$cfg" | awk -F": " "/^memory:/ {print \$2; exit}")
  rootfs=$(printf "%s\n" "$cfg" | awk -F": " "/^rootfs:/ {print \$2; exit}")
  unpriv=$(printf "%s\n" "$cfg" | awk -F": " "/^unprivileged:/ {print \$2; exit}")
  features=$(printf "%s\n" "$cfg" | awk -F": " "/^features:/ {print \$2; exit}")
  net0=$(printf "%s\n" "$cfg" | awk -F": " "/^net0:/ {print \$2; exit}")
  ip=$(printf "%s" "$net0" | sed -n "s/.*,ip=\([^,/]*\).*/\1/p")
  [ -z "$ip" ] && ip="?"
  [ "$unpriv" = "1" ] && priv="unpriv" || priv="PRIV"
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$c" "$hostname" "$cores" "$memory" "$ip" "$rootfs" "$priv" "$features"
done
')"

  cat <<HEADER
# $PMX_NAME — Containers (LXC)

> Auto-generated by \`pmx-inventory snapshot\` on $TIMESTAMP.

## Status summary

\`\`\`
$list
\`\`\`

## Per-container details

| CT | Hostname | IP | Cores | RAM (MB) | Rootfs | Priv? | Features |
|----|----------|-----|-------|----------|--------|-------|----------|
HEADER

  printf '%s\n' "$rows" | while IFS=$'\t' read -r ctid hostname cores memory ip rootfs priv features; do
    [ -z "$ctid" ] && continue
    printf '| %s | %s | %s | %s | %s | `%s` | %s | %s |\n' \
      "$ctid" "${hostname:-?}" "${ip:-?}" "${cores:-?}" "${memory:-?}" "${rootfs:-?}" "$priv" "${features:--}"
  done

  echo
  cat <<FOOTER
## How to refresh

\`\`\`bash
~/.claude/skills/proxmox-admin/scripts/pmx-inventory snapshot --profile $PMX_NAME
\`\`\`
FOOTER
}

emit_vms() {
  local raw
  raw="$(pmx_ssh 'qm list 2>/dev/null')"

  if printf '%s\n' "$raw" | tail -n +2 | grep -q .; then
    cat <<HEADER
# $PMX_NAME — VMs (KVM)

> Auto-generated by \`pmx-inventory snapshot\` on $TIMESTAMP.

\`\`\`
$raw
\`\`\`

## How to refresh

\`\`\`bash
~/.claude/skills/proxmox-admin/scripts/pmx-inventory snapshot --profile $PMX_NAME
\`\`\`
HEADER
  else
    # No VMs — return empty so snapshot skips writing
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
write_category() {
  local cat="$1" emit_fn="$2"
  mkdir -p "$OUT_DIR"
  local target="$OUT_DIR/$cat.md"
  if "$emit_fn" > "$target.new" 2>/dev/null; then
    mv "$target.new" "$target"
    echo "[pmx-inventory] wrote $target" >&2
  else
    rm -f "$target.new"
    if [ "$cat" = "vms" ]; then
      [ -f "$target" ] && { rm "$target"; echo "[pmx-inventory] removed $target (no VMs)" >&2; } || echo "[pmx-inventory] skip $cat (no VMs)" >&2
    else
      echo "[pmx-inventory][warn] failed to emit $cat" >&2
      return 1
    fi
  fi
}

diff_category() {
  local cat="$1" emit_fn="$2"
  local target="$OUT_DIR/$cat.md"
  local fresh
  fresh="$(mktemp)"
  trap "rm -f '$fresh'" EXIT
  if ! "$emit_fn" > "$fresh" 2>/dev/null; then
    if [ "$cat" = "vms" ]; then
      echo "[pmx-inventory] $cat: no VMs (skipping)" >&2
      return 0
    fi
    echo "[pmx-inventory][warn] failed to emit $cat" >&2
    return 1
  fi
  if [ ! -f "$target" ]; then
    echo "[pmx-inventory] $cat: no on-disk file yet — would be newly created" >&2
    return 0
  fi
  if diff -u "$target" "$fresh" > /dev/null 2>&1; then
    echo "[pmx-inventory] $cat: unchanged" >&2
  else
    diff -u "$target" "$fresh" || true
  fi
}

case "$CMD" in
  show)
    case "$CATEGORY" in
      hardware)   emit_hardware ;;
      network)    emit_network ;;
      storage)    emit_storage ;;
      containers) emit_containers ;;
      vms)        emit_vms ;;
    esac
    ;;

  snapshot)
    pmx_log "snapshot target: $OUT_DIR"
    cats="${CATEGORY:-all}"
    if [ "$cats" = "all" ] || [ "$cats" = "" ]; then
      cats="hardware network storage containers vms"
    fi
    for c in $cats; do
      case "$c" in
        hardware)   write_category hardware   emit_hardware ;;
        network)    write_category network    emit_network ;;
        storage)    write_category storage    emit_storage ;;
        containers) write_category containers emit_containers ;;
        vms)        write_category vms        emit_vms ;;
      esac
    done
    ;;

  diff)
    cats="${CATEGORY:-all}"
    if [ "$cats" = "all" ] || [ "$cats" = "" ]; then
      cats="hardware network storage containers vms"
    fi
    for c in $cats; do
      case "$c" in
        hardware)   diff_category hardware   emit_hardware ;;
        network)    diff_category network    emit_network ;;
        storage)    diff_category storage    emit_storage ;;
        containers) diff_category containers emit_containers ;;
        vms)        diff_category vms        emit_vms ;;
      esac
    done
    ;;
esac
